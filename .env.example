# ==========================================
# 🗄️ DATABASE CONFIGURATION (SERVER-ONLY)
# ==========================================
# CRITICAL: NEVER place DATABASE_URL in NEXT_PUBLIC_*. Keep strictly server-side.

# 1. Local Development MySQL (Default)
DATABASE_URL="mysql://root:password@localhost:3306/lanka_luxe_db"

# 2. Production Hosted MySQL Configurations
# On Vercel / Serverless, you MUST use hosted MySQL with SSL and connection pooling.
# - AWS RDS / Aurora:   "mysql://user:pass@mydb.cluster-xyz.region.rds.amazonaws.com:3306/lanka_luxe_db?sslaccept=strict&connection_limit=5"
# - PlanetScale:        "mysql://user:pass@aws.connect.psdb.cloud/lanka_luxe_db?sslaccept=strict&connection_limit=5"
# - Aiven MySQL:        "mysql://avnadmin:pass@mysql-xyz.aivencloud.com:12345/lanka_luxe_db?sslaccept=strict&connection_limit=5"

# ==========================================
# ⚡ DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ==========================================
# CRITICAL: SERVER-ONLY. Required for distributed rate limiting across Vercel serverless instances.
# If omitted during local development, system automatically falls back to local in-memory limiting.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ==========================================
# 🔐 AUTHENTICATION & SECURITY (SERVER-ONLY)
# ==========================================
# JWT Secret Key for Admin Sessions & HttpOnly Cookies
# In production, must be at least 32 characters (256-bit+ secure random):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters"

# Default Admin Credentials for Initial Database Seeding Only
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="replace_with_strong_seed_password_here"

# ==========================================
# 🖼️ IMAGEBB API CONFIGURATION (SERVER-ONLY)
# ==========================================
# Required for admin asset uploads: https://api.imgbb.com/
# NEVER expose this key in client-side bundles or NEXT_PUBLIC_*
IMGBB_API_KEY="your_imgbb_api_key_here"

# ==========================================
# 🌐 APPLICATION PUBLIC URL
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
