# ==========================================
# 🗄️ MYSQL DATABASE CONFIGURATION
# ==========================================

# 1. Primary Prisma MySQL Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/lanka_luxe_db"

# 2. Discrete MySQL Connection Parameters
DB_TYPE="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="lanka_luxe_db"
DB_USER="root"
DB_PASSWORD="password"
DB_SSL="false"

# --- Common MySQL Connection Examples ---
# Local XAMPP/WAMP/Laragon (No password): "mysql://root:@localhost:3306/lanka_luxe_db"
# Local MySQL Workbench / Server:          "mysql://root:yourpassword@localhost:3306/lanka_luxe_db"
# PlanetScale MySQL:                       "mysql://[USER]:[PASSWORD]@[HOST]/lanka_luxe_db?sslaccept=strict"
# Aiven / Railway / AWS RDS:               "mysql://root:[PASSWORD]@[HOST]:3306/lanka_luxe_db"

# ==========================================
# 🔐 AUTHENTICATION & SECURITY
# ==========================================

# JWT Secret Key for Admin Sessions & Cookies
JWT_SECRET="lanka_luxe_super_secure_jwt_secret_token_2026_atelier"

# Default Admin Credentials for Initial Seeding
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="admin123"

# ==========================================
# 🌐 APPLICATION SETTINGS
# ==========================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
