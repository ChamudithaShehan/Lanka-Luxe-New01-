generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique(map: "BlogPost_slug_key")
  titleEn     String
  titleKo     String?
  category    String
  author      String   @default("Iroshan Jayawickrame")
  readTime    String   @default("5 min read")
  publishedAt String
  image       String   @db.Text
  excerptEn   String   @db.Text
  excerptKo   String?  @db.Text
  contentEn   String?  @db.LongText
  contentKo   String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogpost")
}

model Destination {
  id            String   @id @default(cuid())
  slug          String   @unique(map: "Destination_slug_key")
  nameEn        String
  nameKo        String?
  region        String
  duration      String
  image         String   @db.Text
  shortEn       String   @db.Text
  shortKo       String?  @db.Text
  descriptionEn String?  @db.Text
  descriptionKo String?  @db.Text
  highlights    String   @db.Text
  mapX          Float    @default(50)
  mapY          Float    @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("destination")
}

model Experience {
  id            String   @id @default(cuid())
  slug          String   @unique(map: "Experience_slug_key")
  titleEn       String
  titleKo       String?
  category      String
  duration      String
  location      String
  image         String   @db.Text
  descriptionEn String   @db.Text
  descriptionKo String?  @db.Text
  highlights    String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("experience")
}

model GalleryItem {
  id        String   @id @default(cuid())
  titleEn   String
  titleKo   String?
  category  String   @default("Luxury Resorts")
  image     String   @db.Text
  location  String?
  featured  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("galleryitem")
}

model GolfCourse {
  id           String   @id @default(cuid())
  slug         String   @unique(map: "GolfCourse_slug_key")
  name         String
  location     String
  holes        Int      @default(18)
  par          Int      @default(72)
  duration     String   @default("1 Day")
  rounds       Int      @default(1)
  nights       Int      @default(1)
  image        String   @db.Text
  textEn       String   @db.Text
  textKo       String?  @db.Text
  hotelPairing String?
  features     String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("golfcourse")
}

model Inquiry {
  id         String   @id @default(cuid())
  reference  String   @unique(map: "Inquiry_reference_key")
  name       String
  email      String
  phone      String
  country    String?
  tourSlug   String?
  travelers  String?
  travelDate String?
  duration   String?
  budget     String?
  message    String?  @db.Text
  status     String   @default("New")
  notes      String?  @db.Text
  source     String   @default("Website Form")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("inquiry")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique(map: "SiteSetting_key_key")
  value     String   @db.LongText
  updatedAt DateTime @updatedAt

  @@map("sitesetting")
}

model Tour {
  id         String   @id @default(cuid())
  slug       String   @unique(map: "Tour_slug_key")
  nameEn     String
  nameKo     String?
  category   String
  duration   String
  nights     Int?
  price      String
  image      String   @db.Text
  badge      String?
  shortEn    String?  @db.Text
  shortKo    String?  @db.Text
  overviewEn String?  @db.Text
  overviewKo String?  @db.Text
  highlights String   @db.Text
  inclusions String   @db.Text
  exclusions String   @db.Text
  hotels     String   @db.Text
  categories String?  @db.Text
  itinerary  String   @db.LongText
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tour")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique(map: "User_username_key")
  passwordHash String
  name         String   @default("Iroshan Jayawickrame")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user")
}
